# Environment
AMBIENTE=PRODUCTION
DEBUG=False
PORT=5000
NODE_ENV=production

# Database PostgreSQL - Railway will provide this
DATABASE_URL="postgresql://username:password@host:port/database"

# JWT
JWT_SECRET="your_jwt_secret_here_change_in_production"
JWT_EXPIRE="7d"

# SRI Ecuador
SRI_AMBIENTE="1"
SRI_RUC="1790012340001"
SRI_RAZON_SOCIAL="FLORES ETERNAS CIA LTDA"
SRI_NOMBRE_COMERCIAL="Flores Eternas"
SRI_CERTIFICADO_PATH="./certs/certificado_pruebas.p12"
SRI_CERTIFICADO_CLAVE="clave_certificado_pruebas"
SRI_DIR_MATRIZ="AV PRINCIPAL 123 Y SECUNDARIA"

# Archivos
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE="5242880"

# Email (configurar según proveedor)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu_email@gmail.com"
SMTP_PASS="tu_app_password"

# WhatsApp
WHATSAPP_NUMBER="593993162228"

# CORS
ALLOWED_ORIGINS="https://your-frontend-domain.railway.app"
FRONTEND_URL="https://your-frontend-domain.railway.app"

# API
API_BASE_URL="https://your-backend-domain.railway.app"